<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Electricity Bill Calculator</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<h1>Electricity Bill Calculator</h1>
<label>Enter the units consumed</label>
<input type="number" id="units" placeholder="Enter units...">
<button onclick="calculateBill()">Calculate Bill</button>
<h2 id ="result"></h2>
<script src="script.js"></script>
</body>
</html>


function calculateBill(){
    let units = Number(document.getElementById("units").value);
    let bills = 0;
    if(units <=100){
        bills = units*2;
    }
    else if(units <= 200){
        bills = (100*2)+((units - 100 )*3);
    }
    else if(units <= 500){
        bills = (100*2)+( 100 *3)+((units - 200 )*5);

    }
    else{
        bills = (100*2)+((100*3)+( 300*5))+ ((units - 500 )*7);
    }
    document.getElementById("result").innerHTML = "Total Electricity Bills = Rs"+bills;
}


body{
    font-family: Arial, Helvetica, sans-serif;
    margin: 40px;
}
input{
    padding: 8px;
    margin: 10px;
}
button{
    padding: 8px 15px;
    margin-left: 10px;
}
#result{
    margin-top: 20px;
}
